# .env.example — copy to .env and fill in the keys you actually use.
#   cp .env.example .env
# Your real .env is gitignored (it holds secrets); this .example file is the committed template.
# Only set what the skills/tools you wire up need — leave the rest blank.

# --- Your brain's basics ---------------------------------------------------
# Absolute path to this repo on your machine (some hooks/scripts use $SECOND_BRAIN_ROOT)
SECOND_BRAIN_ROOT=
# Your timezone for timestamps — IANA name, e.g. America/New_York, Europe/Berlin (default UTC)
SECOND_BRAIN_TZ=UTC

# --- Image generation: /nano-banana-flash, /nano-banana-pro ----------------
# Google Gemini key. Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Add keys for any other tools / "superpowers" you use regularly --------
# Uncomment + fill the ones that apply, and add your own:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ELEVENLABS_API_KEY=        # voice / text-to-speech
# DEEPGRAM_API_KEY=          # speech-to-text / dictation capture
# REPLICATE_API_TOKEN=
# GITHUB_TOKEN=
